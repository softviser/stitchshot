<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/StitchShot.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <AssemblyName>StitchShot</AssemblyName>
    <Product>StitchShot</Product>
    <Company>Softviser Yazılım</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SharpHook" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\HELP.md" LogicalName="HELP.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StitchShot.Core\StitchShot.Core.csproj" />
    <ProjectReference Include="..\StitchShot.Platform.Windows\StitchShot.Platform.Windows.csproj" />
    <ProjectReference Include="..\StitchShot.Platform.Linux\StitchShot.Platform.Linux.csproj" />
    <ProjectReference Include="..\StitchShot.Platform.Mac\StitchShot.Platform.Mac.csproj" />
  </ItemGroup>
</Project>
